@model BookAppointment

<header class="d-flex justify-content-between align-items-center">
    <h1>Book Appointment</h1>
    <form method="get" asp-controller="Doctors" asp-action="BookAppointment" class="d-flex align-items-center gap-3">
        <input
            type="text"
            class="form-control"
            id="search"
            name="search"
            placeholder="Search Here!"
            value="@Model.Search"
        >
        <select class="form-select" aria-label="Default select example" name="specialization">
            <option value="">Choose Specialization</option>
            @foreach (var specialization in Model.Specializations)
            {
                <option value="@specialization" selected="@(specialization == Model.Specialization)">
                    @specialization
                </option>
            }
        </select>
        <button type="submit" class="btn btn-outline-primary">Submit</button>
    </form>
</header>

<section class="row g-4">
    @foreach (var doctor in Model.Doctors)
    {
        <div class="col-4">
            <div class="card">
                <img src="~/images/@doctor.Img" class="card-img-top" alt="@doctor.Name">
                <div class="card-body">
                    <h5 class="card-title">@doctor.Name</h5>
                    <p class="card-text">Specialization: @doctor.Specialization</p>
                    <a
                        class="btn btn-outline-primary"
                        asp-controller="Doctors"
                        asp-action="CompleteAppointment"
                        asp-route-id="@doctor.Id">
                        Book Appointment
                    </a>
                </div>
            </div>
        </div>
    }
</section>

<nav class="d-flex justify-content-center mt-4" aria-label="Page navigation example">
    <ul class="pagination gap-2">
        @for (int i = 1; i <= Model.PagesCount; i++)
        {
            <li class="page-item">
                <button class="btn btn-primary p-0" type="button" disabled="@(i == Model.Page)">
                    <a
                        class="text-white text-decoration-none d-inline-block py-2 px-3"
                        asp-all-route-data="@Context.Request.Query.ToDictionary(x => x.Key, x => x.Value.ToString())"
                        asp-route-page="@i">@i</a>
                </button>
            </li>
        }
    </ul>
</nav>