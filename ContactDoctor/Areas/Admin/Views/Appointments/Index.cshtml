@model List<Appointment>

<div class="container py-3">
	<h1>Appointments</h1>

	<table class="table table-hover">
		<thead>
			<tr>
				<th>#</th>
				<th>Patient</th>
				<th>Doctor</th>
				<th>Date</th>
				<th>Time</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			@for (var i = 0; i < Model.Count; i++)
			{
				<tr>
					<td class="align-middle">@(i + 1)</td>
					<td class="align-middle">@Model[i].PatientName</td>
					<td class="align-middle">@Model[i].Doctor.Name</td>
					<td class="align-middle">@Model[i].AppointmentDateTime.ToString("MM/dd/yyyy")</td>
					<td class="align-middle">@Model[i].AppointmentDateTime.ToString(@"hh\:mm")</td>
					<td class="align-middle">
						<span class="d-flex gap-3">
							<a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@Model[i].Id">
								Edit
							</a>
							<a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model[i].Id">
								Delete
							</a>
						</span>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>